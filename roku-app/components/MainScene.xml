<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

    <children>
        <!-- 1920x1080 Room Backdrop -->
        <Poster
            id="backdrop"
            uri="pkg:/images/wjrn-roku-player-backdrop.png"
            width="1920"
            height="1080" />

        <!-- Vintage Player Group centered on the credenza -->
        <Group id="playerContainer" translation="[320, 340]">

            <!-- 1a. Fallback art (always the local packaged image, never blank) — same
                 square default-art image the website/Android app fall back to
                 (jacewon-thumbnail.jpg), not the widescreen splash screen. The splash
                 screen is a 1920x1080 marketing graphic; scaleToZoom into a 274x274
                 window was cropping it into an unrecognizable "screenshot" any time
                 remote art was cleared on station change. -->
            <Poster
                id="albumArtBase"
                uri="pkg:/images/wjrn-roku-default-art.png"
                translation="[111, 101]"
                width="274"
                height="274"
                loadDisplayMode="scaleToZoom" />

            <!-- 1b. Remote now-playing art, layered on top — starts empty so albumArtBase
                 shows through underneath instead of a blank/transparent gap while it loads. -->
            <Poster
                id="albumArtRemote"
                uri=""
                translation="[111, 101]"
                width="274"
                height="274"
                loadDisplayMode="scaleToZoom" />

            <!-- 2. Faceplate — masks the album art behind its one knockout window. Everything
                 below this point (VU meter, tuner tick, ticker) renders ON TOP of the
                 faceplate, not behind it — only the art sits behind/through the cutout. -->
            <Poster
                id="faceplate"
                uri="pkg:/images/wjrn-roku-receiver-front-ko.png"
                width="1280"
                height="443" />

            <!-- 3. VU meter — a real pivoting needle, matching the web player's canvas-drawn
                 gauge exactly (public/player/index.html drawVU(): pivot at box-local (75.5,79),
                 needle length 60, sweeps between vuAngle=PI/4 and PI/4+PI/2 i.e. a 90° sweep
                 centered on straight-up). Box sits at (423,104), so the pivot in
                 playerContainer space is (423+75.5, 104+79) = (498.5, 183). Roku's Rectangle
                 has no separate pivot field for rotation — scaleRotateCenter in the
                 Rectangle's own LOCAL coordinates does that job; set to the rectangle's
                 bottom-center [1,60] so translation [497.5,123] (pivot minus that local
                 offset) places the true pivot at (498.5,183) as intended, and `rotation`
                 (radians; Roku docs: positive = counterclockwise, rotates about
                 scaleRotateCenter) then swings the needle around its base rather than its
                 top-left corner. Roku's Audio node has no real-time amplitude API like the
                 web player's AnalyserNode, so the sweep is a decorative loop while playing,
                 not genuine audio-reactive analysis — same platform limitation as before,
                 now at least shaped like the real gauge instead of an unrelated bar meter. -->
            <Rectangle
                id="vuNeedle"
                color="#ff3333"
                translation="[497.5, 123]"
                width="2"
                height="60"
                scaleRotateCenter="[1, 60]"
                rotation="0.785" />
            <Animation id="vuAnim" duration="0.9" repeat="true" easeFunction="inOutQuad">
                <FloatFieldInterpolator id="vuInterp" fieldToInterp="vuNeedle.rotation" />
            </Animation>

            <!-- 4. Tuner Tick Line, on top of the faceplate — slides between frequencies.
                 Matches #tuner-tick exactly: width 4px (not 6), color #ff3333. Roku's
                 Rectangle has no box-shadow field, so the CSS drop shadow
                 (1px 2px 4px rgba(0,0,0,.55), 0 1px 2px rgba(0,0,0,.35)) is faked with a
                 dark, slightly larger, offset Rectangle drawn directly behind it — same
                 offset-duplicate trick used for the ticker glow. -->
            <Rectangle
                id="tunerTickShadow"
                color="0x00000099"
                translation="[683, 135]"
                width="5"
                height="39" />
            <Rectangle
                id="tunerTick"
                color="#ff3333"
                translation="[682, 133]"
                width="4"
                height="38" />
            <Animation id="tickAnim" duration="0.4" easeFunction="inOutExpo">
                <Vector2DFieldInterpolator id="tickInterp" fieldToInterp="tunerTick.translation" />
                <Vector2DFieldInterpolator id="tickShadowInterp" fieldToInterp="tunerTickShadow.translation" />
            </Animation>

            <!-- 5. Metadata Ticker, on top of the faceplate. Wrapped in its own Group
                 with a clippingRect so scrolling text is actually contained to the ticker
                 window (matching the web player's CSS overflow-clip) instead of bleeding
                 into neighboring elements like the album art when it scrolls far. -->
            <Group id="tickerClip" translation="[410, 214]" clippingRect="[0, 0, 569, 48]">
                <!-- Matches public/player/index.html's #ticker-text exactly: color #23bf91,
                     uppercase (applied in BRS via UCase), monospace, letter-spaced. Roku's
                     Label has no text-shadow/glow field, so the CSS glow
                     (text-shadow: 0 0 8px rgba(35,191,145,0.6)) is faked with two offset
                     duplicate labels at reduced opacity behind the real one — a standard
                     Roku technique for approximating a soft glow. All three live inside
                     tickerScroll so one animation moves all three together for the marquee. -->
                <!-- Reference #ticker-text is font-size: 14px — none of Roku's named system
                     fonts (TinySystemFont..ExtraLargeBoldSystemFont, all proportional, no
                     monospace variant, verified against official docs) land anywhere near
                     that at this canvas scale, so this uses a Font node with an explicit
                     size instead — a Font's `size` field works with no `uri` given (falls
                     back to Roku's default font family at that exact pixel size), unlike
                     the earlier named-keyword approach which was stuck at a fixed, too-large
                     size. -->
                <Group id="tickerScroll" translation="[0, 0]">
                    <Label id="tickerGlow1" text="" translation="[-1, -1]" width="569" height="48" horizAlign="left" vertAlign="center" color="#23bf91" opacity="0.5">
                        <Font role="font" size="14" />
                    </Label>
                    <Label id="tickerGlow2" text="" translation="[1, 1]" width="569" height="48" horizAlign="left" vertAlign="center" color="#23bf91" opacity="0.5">
                        <Font role="font" size="14" />
                    </Label>
                    <Label id="tickerText" text="LOADING WJRN..." translation="[0, 0]" width="569" height="48" horizAlign="left" vertAlign="center" color="#23bf91">
                        <Font role="font" size="14" />
                    </Label>
                </Group>
                <Animation id="tickerAnim" duration="6" repeat="true" easeFunction="linear">
                    <Vector2DFieldInterpolator id="tickerInterp" fieldToInterp="tickerScroll.translation" />
                </Animation>
            </Group>

        </Group>

        <!-- Hidden Native Audio Engine -->
        <Audio id="audioPlayer" />

        <!-- Separate audio node for the one-shot tuning static sound effect, so it can
             play independently of (and briefly overlap with) the station stream swap. -->
        <Audio id="sfxPlayer" />
    </children>
</component>
