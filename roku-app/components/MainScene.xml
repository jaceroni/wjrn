<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

    <children>
        <!-- 1920x1080 Room Backdrop -->
        <Poster
            id="backdrop"
            uri="pkg:/images/wjrn-roku-player-backdrop.png"
            width="1920"
            height="1080" />

        <!-- Vintage Player Group centered on the credenza -->
        <Group id="playerContainer" translation="[320, 340]">

            <!-- 1a. Fallback art (always the local packaged image, never blank) — same
                 square default-art image the website/Android app fall back to
                 (jacewon-thumbnail.jpg), not the widescreen splash screen. The splash
                 screen is a 1920x1080 marketing graphic; scaleToZoom into a 274x274
                 window was cropping it into an unrecognizable "screenshot" any time
                 remote art was cleared on station change. -->
            <Poster
                id="albumArtBase"
                uri="pkg:/images/wjrn-roku-default-art.png"
                translation="[111, 101]"
                width="274"
                height="274"
                loadDisplayMode="scaleToZoom" />

            <!-- 1b. Remote now-playing art, layered on top — starts empty so albumArtBase
                 shows through underneath instead of a blank/transparent gap while it loads. -->
            <Poster
                id="albumArtRemote"
                uri=""
                translation="[111, 101]"
                width="274"
                height="274"
                loadDisplayMode="scaleToZoom" />

            <!-- 2. Faceplate — masks the album art behind its one knockout window. Everything
                 below this point (VU meter, tuner tick, ticker) renders ON TOP of the
                 faceplate, not behind it — only the art sits behind/through the cutout. -->
            <Poster
                id="faceplate"
                uri="pkg:/images/wjrn-roku-receiver-front-ko.png"
                width="1280"
                height="443" />

            <!-- 3. Decorative VU meter bars, on top of the faceplate — Roku's Audio node has
                 no real-time amplitude API, so this is a lively decorative loop rather than
                 genuine music-reactive analysis. Anim/Interpolator nodes are siblings of the
                 bars they animate — required for fieldToInterp to resolve. -->
            <Group id="vuMeter" translation="[0, 0]">
                <Rectangle id="vuBar0" color="#d7b158" translation="[439, 143]" width="24" height="8" />
                <Rectangle id="vuBar1" color="#d7b158" translation="[471, 143]" width="24" height="8" />
                <Rectangle id="vuBar2" color="#d7b158" translation="[503, 143]" width="24" height="8" />
                <Rectangle id="vuBar3" color="#d7b158" translation="[535, 143]" width="24" height="8" />

                <Animation id="vuAnim0" duration="0.9" repeat="true" easeFunction="inOutQuad">
                    <FloatFieldInterpolator id="vuInterp0" fieldToInterp="vuBar0.height" />
                </Animation>
                <Animation id="vuAnim1" duration="1.3" repeat="true" easeFunction="inOutQuad">
                    <FloatFieldInterpolator id="vuInterp1" fieldToInterp="vuBar1.height" />
                </Animation>
                <Animation id="vuAnim2" duration="0.7" repeat="true" easeFunction="inOutQuad">
                    <FloatFieldInterpolator id="vuInterp2" fieldToInterp="vuBar2.height" />
                </Animation>
                <Animation id="vuAnim3" duration="1.1" repeat="true" easeFunction="inOutQuad">
                    <FloatFieldInterpolator id="vuInterp3" fieldToInterp="vuBar3.height" />
                </Animation>
            </Group>

            <!-- 4. Tuner Tick Line, on top of the faceplate — slides between frequencies -->
            <Rectangle
                id="tunerTick"
                color="#ff3333"
                translation="[682, 133]"
                width="6"
                height="38" />
            <Animation id="tickAnim" duration="0.4" easeFunction="inOutExpo">
                <Vector2DFieldInterpolator id="tickInterp" fieldToInterp="tunerTick.translation" />
            </Animation>

            <!-- 5. Metadata Ticker, on top of the faceplate. Wrapped in its own Group
                 with a clippingRect so scrolling text is actually contained to the ticker
                 window (matching the web player's CSS overflow-clip) instead of bleeding
                 into neighboring elements like the album art when it scrolls far. -->
            <Group id="tickerClip" translation="[410, 214]" clippingRect="[0, 0, 569, 48]">
                <!-- Matches public/player/index.html's #ticker-text exactly: color #23bf91,
                     uppercase (applied in BRS via UCase), monospace, letter-spaced. Roku's
                     Label has no text-shadow/glow field, so the CSS glow
                     (text-shadow: 0 0 8px rgba(35,191,145,0.6)) is faked with two offset
                     duplicate labels at reduced opacity behind the real one — a standard
                     Roku technique for approximating a soft glow. All three live inside
                     tickerScroll so one animation moves all three together for the marquee. -->
                <!-- No monospace system font exists on Roku (verified against official docs —
                     TinySystemFont through ExtraLargeBoldSystemFont, all proportional, no
                     monospace variant), so this uses the closest bold system font instead
                     of guessing at a font file that doesn't exist in this project. -->
                <Group id="tickerScroll" translation="[0, 0]">
                    <Label id="tickerGlow1" text="" translation="[-1, -1]" width="569" height="48" horizAlign="left" vertAlign="center" color="#23bf91" opacity="0.5" font="font:LargeBoldSystemFont" />
                    <Label id="tickerGlow2" text="" translation="[1, 1]" width="569" height="48" horizAlign="left" vertAlign="center" color="#23bf91" opacity="0.5" font="font:LargeBoldSystemFont" />
                    <Label id="tickerText" text="LOADING WJRN..." translation="[0, 0]" width="569" height="48" horizAlign="left" vertAlign="center" color="#23bf91" font="font:LargeBoldSystemFont" />
                </Group>
                <Animation id="tickerAnim" duration="6" repeat="true" easeFunction="linear">
                    <Vector2DFieldInterpolator id="tickerInterp" fieldToInterp="tickerScroll.translation" />
                </Animation>
            </Group>

        </Group>

        <!-- Hidden Native Audio Engine -->
        <Audio id="audioPlayer" />

        <!-- Separate audio node for the one-shot tuning static sound effect, so it can
             play independently of (and briefly overlap with) the station stream swap. -->
        <Audio id="sfxPlayer" />
    </children>
</component>
